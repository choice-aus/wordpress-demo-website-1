{
  "name": "choice/wordpress-demo-website-1",
  "description": "Demo Website #1",
  "type": "project",
  "license": "proprietary",
  "prefer-stable": true,
  "minimum-stability": "dev",
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    }
  ],
  "config": {
    "sort-packages": true,
    "process-timeout": 600,
    "preferred-install": "dist",
    "vendor-dir": "public/wp-content/plugins/vendor",
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "composer/installers": true,
      "cweagans/composer-patches": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "johnpbloch/wordpress-core-installer": true
    }
  },
  "require": {
    "php": "^8.2",
    "johnpbloch/wordpress": "^6.4",
    "johnpbloch/wordpress-core-installer": "^2.0",
    "wpackagist-plugin/advanced-custom-fields": "^6.0",
    "ext-mysqli": "*",
    "wpackagist-theme/twentytwentyfive": "^1.4",
    "wpackagist-plugin/memcached": "^4.0",
    "humanmade/wordpress-pecl-memcached-object-cache": "^2.1"
  },
  "extra": {
    "wordpress-install-dir": "public/wp",
    "installer-paths": {
      "public/wp-content/plugins/{$name}": [
        "type:wordpress-plugin"
      ],
      "public/wp-content/themes/{$name}": [
        "type:wordpress-theme"
      ],
      "public/wp-content/mu-plugins/{$name}": [
        "type:wordpress-muplugin"
      ]
    }
  },
  "scripts": {
    "post-install-cmd": [
      "cp -f ./public/wp-content/plugins/vendor/humanmade/wordpress-pecl-memcached-object-cache/object-cache.php ./public/wp-content/object-cache.php"
    ],
    "lint": [
      "phpcs --colors --runtime-set ignore_warnings_on_exit 1"
    ],
    "lint-fix": "phpcbf",
    "verify": [
      "composer validate --no-check-all --no-check-publish --strict"
    ],
    "test": [
      "phpunit --configuration=./phpunit.xml"
    ]
  }

